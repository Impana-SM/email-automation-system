# Email Automation & Reminder System Configuration

# Application
APP_ENV=development
DEBUG=True
PORT=8000

# Mock Mode (Set to True for testing without actual SMTP server)
USE_MOCK_EMAIL=True

# Database (Default: SQLite local file)
DATABASE_URL=sqlite:///./email_automation.db

# SMTP Configuration (Used when USE_MOCK_EMAIL=False)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=True
FROM_EMAIL=noreply@emailautomation.com
